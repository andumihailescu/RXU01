{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Start OpenOCD ESP-Prog 2 C3",
            "type": "process",
            "command": "C:\\Espressif\\tools\\openocd-esp32\\v0.12.0-esp32-20260424\\openocd-esp32\\bin\\openocd.exe",
            "args": [
                "-s",
                "C:\\Espressif\\tools\\openocd-esp32\\v0.12.0-esp32-20260424\\openocd-esp32\\share\\openocd\\scripts",
                "-f",
                "board/esp32c3-bridge.cfg",
                "-c",
                "adapter speed 1000"
            ],
            "isBackground": true,
            "problemMatcher": {
                "owner": "openocd",
                "pattern": {
                    "regexp": "^$"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "Open On-Chip Debugger",
                    "endsPattern": "Listening on port 3333 for gdb connections"
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            }
        },
        {
            "label": "Stop OpenOCD",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-Command",
                "Get-Process openocd -ErrorAction SilentlyContinue | Stop-Process -Force"
            ],
            "problemMatcher": []
        }
    ]
}
